{
  "name": "healthcare-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "National healthcare platform for Bangladesh — patient PWA, hospital consoles, and the live queue engine.",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:api": "pnpm --filter @platform/api dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @platform/database migrate",
    "db:seed": "pnpm --filter @platform/database seed",
    "db:reset": "pnpm --filter @platform/database reset",
    "db:verify": "pnpm --filter @platform/database verify",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "clean": "pnpm -r exec rm -rf dist .next .turbo coverage *.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@platform/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
