# HealthWealthBD on a hospital's own server — copy to deploy/.env and fill in.
# DEPLOY.md §S2 explains each value. deploy/.env holds secrets: it is never
# committed and never copied into an image (.gitignore, .dockerignore).

# --- The three addresses ---------------------------------------------------
# https:// origins get certificates automatically once DNS points here. To try
# the stack on a machine with no public name, use the http:// localhost ones.
APP_ORIGIN=http://app.localhost
CONSOLE_ORIGIN=http://console.localhost
API_ORIGIN=http://api.localhost
# APP_ORIGIN=https://app.hospital.com.bd
# CONSOLE_ORIGIN=https://console.hospital.com.bd
# API_ORIGIN=https://api.hospital.com.bd
HTTP_PORT=80
HTTPS_PORT=443

# --- The database ----------------------------------------------------------
POSTGRES_USER=healthwealthbd
# A long random password: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=healthwealthbd

# --- Secrets: four different values, each 32+ characters --------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GUEST_LINK_SECRET=
# Encrypts every administrator's two-step verification (pilot step 28). Keep a
# copy with the backups' keys, not beside the backups: a restored database
# needs this same value, or every administrator must be reset
# (pnpm staff:reset-2fa) and set it up again.
TOTP_ENCRYPTION_KEY=

# --- What this deployment offers --------------------------------------------
# off: patients pay at the hospital only, until merchant accounts exist.
PAYMENT_PROVIDER=off
# log: messages are recorded, not sent, until an SMS aggregator is arranged
# (pilot step 27). A patient then follows their serial from the link the
# booking screen shows.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=

# --- Backups -----------------------------------------------------------------
# 20 UTC is 02:00 in Dhaka.
BACKUP_AT_UTC_HOUR=20
BACKUP_KEEP_DAYS=14

LOG_LEVEL=info
