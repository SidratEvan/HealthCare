# HealthWealthBD on a hospital's own server — copy to deploy/.env and fill in.
# DEPLOY.md §S2 explains each value. deploy/.env holds secrets: it is never
# committed and never copied into an image (.gitignore, .dockerignore).

# --- The three addresses ---------------------------------------------------
# https:// origins get certificates automatically once DNS points here. To try
# the stack on a machine with no public name, use the http:// localhost ones.
APP_ORIGIN=http://app.localhost
CONSOLE_ORIGIN=http://console.localhost
API_ORIGIN=http://api.localhost
# APP_ORIGIN=https://app.hospital.com.bd
# CONSOLE_ORIGIN=https://console.hospital.com.bd
# API_ORIGIN=https://api.hospital.com.bd
HTTP_PORT=80
HTTPS_PORT=443

# --- The database ----------------------------------------------------------
# Two roles, two different passwords.
# The owner: runs the migrations and the backups, and serves no request.
POSTGRES_USER=healthwealthbd
# A long random password: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=healthwealthbd
# What the API connects as: it reads and writes rows and can do nothing else —
# no schema changes, no new roles, no deleting an audit row. Created on the
# first start. The same command makes its password (16 characters or more;
# letters, digits, - and _ only, because it travels inside an address).
API_DB_USER=healthwealthbd_api
API_DB_PASSWORD=

# --- Secrets: four different values, each 32+ characters --------------------
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
GUEST_LINK_SECRET=
# Encrypts every administrator's two-step verification (pilot step 28). Keep a
# copy with the backups' keys, not beside the backups: a restored database
# needs this same value, or every administrator must be reset
# (pnpm staff:reset-2fa) and set it up again.
TOTP_ENCRYPTION_KEY=

# --- What this deployment offers --------------------------------------------
# off: patients pay at the hospital only, until merchant accounts exist.
PAYMENT_PROVIDER=off
# log: messages are recorded, not sent, until an SMS aggregator is arranged
# (pilot step 27). A patient then follows their serial from the link the
# booking screen shows.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
# How many people one address stands for. The API refuses the 31st phone check
# from one address in ten minutes. If patients book from the hospital's own
# Wi-Fi they all share its address: raise this (10 allows 300). 1 to 100.
ADDRESS_RATE_LIMIT_FACTOR=1

# More browser origins for the API to answer, besides the three above: exact
# origins, comma-separated (FR-BRD-04). Leave empty unless a hospital's portal
# or app is served from a name of its own.
EXTRA_ALLOWED_ORIGINS=

# --- Backups -----------------------------------------------------------------
# 20 UTC is 02:00 in Dhaka.
BACKUP_AT_UTC_HOUR=20
BACKUP_KEEP_DAYS=14
# A folder on ANOTHER disk or machine the hospital controls — an external
# drive, a network share mounted on this server. Every night's backup is copied
# there and checked. Left empty, backups stay on this disk only and the backup
# service reports itself as failing, because that is not a second copy. Never a
# service outside Bangladesh without the hospital's agreement (FR-SEC-07).
BACKUP_SECOND_DIR=
# true: each night's dump is restored into a scratch database to prove it
# restores, then the scratch is dropped. Needs free disk the size of the
# database. false only reads the archive's contents list.
BACKUP_VERIFY_RESTORE=true

LOG_LEVEL=info
