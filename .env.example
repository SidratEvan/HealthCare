# ============================================================================
#  Environment template — every variable in BACKEND.md §10.
#
#  Copy to `.env` and fill in. `apps/api/src/env.ts` validates this list with
#  zod at boot and refuses to start if a required key is missing (BACKEND.md §10).
#
#  Never commit a real `.env`. Never put real patient data in a dev or demo
#  database (FR-SEC-08). Never log the secrets on this page (CLAUDE.md §7).
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (DATABASE.md) — matches the local Postgres in docker-compose.yml.
# Run `docker compose up -d` and this URL works as written.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://healthcare:healthcare@localhost:5432/healthcare_dev
DATABASE_POOL_MAX=10

# Throwaway database for the repository and API suites (BACKEND.md §11).
# Not part of the runtime contract in BACKEND.md §10 — test infrastructure only.
# If unset, the suites derive it by swapping _dev for _test in DATABASE_URL and
# refuse to run unless the resulting name ends in _test.
DATABASE_URL_TEST=postgresql://healthcare:healthcare@localhost:5432/healthcare_test

# ---------------------------------------------------------------------------
# Supabase — storage for reports, prescriptions and uploads (signed URLs only).
# Leave blank for local development; the local Postgres above is the database.
# The service-role key is used by the API and workers only, never by a client.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=healthcare-dev

# ---------------------------------------------------------------------------
# Auth — JWT access (15 min) + refresh (30 days), per BACKEND.md §0.
# Generate dev secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Guest tracking links (FR-GST-05) — one booking per link, revocable,
# expires at session end plus grace.
# ---------------------------------------------------------------------------
GUEST_LINK_SECRET=
GUEST_LINK_TTL_DAYS=30

# ---------------------------------------------------------------------------
# OTP (FR-SEC-05, FR-GST-03)
# ---------------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_PER_HOUR=5

# ---------------------------------------------------------------------------
# SMS — `log` writes to console + the notifications table instead of sending,
# which is what development and the demo use. `local` is the BD aggregator.
# ---------------------------------------------------------------------------
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
SMS_MONTHLY_CAP=20000

# ---------------------------------------------------------------------------
# Web Push (VAPID) for the patient PWA.
# Generate a dev keypair with:  npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com

# ---------------------------------------------------------------------------
# Payments — `mock` always succeeds and is the only value used in v0 demos.
# The bKash and Nagad keys below are wired in step 18 (feat/payments).
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Travel time for emergency ranking (FR-PAT-43). `static` uses the built-in
# distance matrix, which is what v0 ships.
# ---------------------------------------------------------------------------
TRAVEL_TIME_MODE=static
MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Freshness — beyond this age a live figure is labelled stale and de-ranked
# in emergency results (FR-OFF-04, FR-PAT-45).
# ---------------------------------------------------------------------------
STALE_THRESHOLD_MINUTES=10

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Demo mode — allows seed and reset, forces mock payments, and shows the
# demonstration-data banner in the UI (FR-DEM-07).
# ---------------------------------------------------------------------------
DEMO_MODE=true
